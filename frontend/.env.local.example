# ==============================================================================
# Next.js Frontend Local Environment Configuration Template
# Copy this file to .env.local for local development. DO NOT commit actual secrets.
#   cp .env.local.example .env.local
# ==============================================================================

# Base URL của Inference Service (KHÔNG kèm hậu tố /api/v1 — code tự thêm).
# Mặc định trong code là http://localhost:8000 nếu không đặt biến này.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API key gửi qua header X-API-Key cho mọi request /api/v1.
# Phải khớp với API_KEY cấu hình ở inference service (.env backend). Để trống ở template.
NEXT_PUBLIC_API_KEY=
