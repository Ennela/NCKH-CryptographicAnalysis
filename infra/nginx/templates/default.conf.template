# Reverse proxy for docker-compose.prod.yml.
#
# The official nginx image renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/ at start-up with envsubst. Only variables that exist in the
# container environment are replaced (here: ${API_KEY_SECRET}); nginx's own
# variables such as $host or $remote_addr are left untouched.

# Resolve service names through Docker's DNS at request time. A static
# `upstream` block resolves once at start-up, so nginx keeps calling the old IP
# (502 Bad Gateway) after `docker compose up --build` recreates a service.
resolver 127.0.0.11 valid=10s ipv6=off;

# Real client address. The optional `cloudflared` service reaches nginx from the
# Docker network and passes the visitor's address in CF-Connecting-IP. That
# header is trusted only from private (Docker) addresses; a visitor connecting
# directly keeps the address of their own connection.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

# Coarse per-visitor limit for the whole API (the inference service additionally
# limits /predict and /explain per minute). A dashboard page fires a handful of
# requests at once, hence the burst.
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=10r/s;
limit_req_status 429;

server {
    listen 80;
    server_name _;
    client_max_body_size 1m;

    location / {
        set $frontend_upstream frontend:3000;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # The "Vận hành" page asks for the inference liveness at /health (outside
    # /api/v1, no API key). Without this it falls through to the frontend: 404.
    location = /health {
        set $inference_upstream inference:8000;
        proxy_pass http://$inference_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /api/v1/ {
        limit_req zone=api_per_ip burst=40 nodelay;

        # With a variable and no URI part, the request path (/api/v1/...) is
        # passed through unchanged.
        set $inference_upstream inference:8000;
        proxy_pass http://$inference_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (do not append) so a visitor cannot forge their address;
        # uvicorn reads it with --proxy-headers and the rate limiter keys on it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The browser never holds the API key: the frontend calls /api/v1 on the
        # same origin and nginx attaches the key here, replacing any key the
        # client sent. No CORS headers are needed because the origin is shared.
        proxy_set_header X-API-Key "${API_KEY_SECRET}";
    }
}
